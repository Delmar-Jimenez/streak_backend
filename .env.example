# Generate a new secret with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=api.example.com
DATABASE_URL=postgresql://streak:REPLACE_PASSWORD@localhost:5432/streak
CORS_ALLOWED_ORIGINS=https://app.example.com
CSRF_TRUSTED_ORIGINS=https://api.example.com
SECURE_SSL_REDIRECT=True
# Enable only behind a trusted proxy that replaces X-Forwarded-Proto.
TRUST_PROXY_HTTPS=False
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
# Resend uses HTTPS and works without SMTP ports on Render Free.
EMAIL_BACKEND=anymail.backends.resend.EmailBackend
RESEND_API_KEY=
# Use a sender from a domain you own and have verified in Resend.
DEFAULT_FROM_EMAIL=
# Optional SMTP configuration for other hosting environments.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
# Empty uses this backend's HTTPS /recuperar-acceso/ page.
# An override must accept uid/token in the URL fragment.
PASSWORD_RESET_URL=
# Optional, only after Flutter implements the deep link.
PASSWORD_RESET_APP_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Test keys and test webhook events only. Real charges require an explicit change.
STRIPE_LIVE_MODE=False
STRIPE_PRO_AMOUNT=500
STRIPE_CURRENCY=usd
# Legacy files only. New images are stored in the existing database.
MEDIA_ROOT=media
