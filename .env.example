# Generate a new secret with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=api.example.com
DATABASE_URL=postgresql://streak:REPLACE_PASSWORD@localhost:5432/streak
CORS_ALLOWED_ORIGINS=https://app.example.com
CSRF_TRUSTED_ORIGINS=https://api.example.com
SECURE_SSL_REDIRECT=True
# Enable only behind a trusted proxy that replaces X-Forwarded-Proto.
TRUST_PROXY_HTTPS=False
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@example.com
# Web/app link that accepts uid and token query parameters.
PASSWORD_RESET_URL=https://app.example.com/reset-password
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_AMOUNT=500
STRIPE_CURRENCY=usd
# Configure an absolute persistent path on the deployment host.
MEDIA_ROOT=media
